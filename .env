# Aracribs - Backend Server Environment Configuration
PORT=3001
JWT_SECRET=aracribs_super_secret_jwt_key_2026

# DATABASE CONFIGURATION
# Default: 'embedded' (Uses zero-config persistent storage in server/data/db.json)
# Options: 'embedded' | 'mongodb' | 'postgres'
DATABASE_TYPE=embedded

# If using MongoDB (Optional):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aracribs?retryWrites=true&w=majority

# If using PostgreSQL (Optional):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aracribs
